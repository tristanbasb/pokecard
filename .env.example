# Clé API Anthropic (console.anthropic.com). Ne jamais la partager ni la commiter.
ANTHROPIC_API_KEY=

# Code PIN demandé dans l'app. Laisser vide pour désactiver.
PIN=

# Port d'écoute du serveur.
PORT=3000

# Effort de Claude: low (plus rapide), medium ou high (plus précis, plus cher).
CLAUDE_EFFORT=medium

# Dossier de la base SQLite et des photos.
DATA_DIR=./data
